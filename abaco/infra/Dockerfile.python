# API y worker comparten imagen: los dos necesitan abaco_core y sus dependencias
# analíticas, que son lo pesado. Una imagen por servicio duplicaría ~1.5 GB.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1

RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential libgomp1 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY packages/core /app/packages/core
COPY services/worker /app/services/worker
COPY services/api /app/services/api

RUN pip install --upgrade pip \
 && pip install -e "packages/core[todo]" -e services/worker -e services/api

RUN useradd --uid 10001 --create-home abaco && mkdir -p /datos && chown abaco /datos
USER abaco

EXPOSE 8000
CMD ["uvicorn", "abaco_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
