# API y worker comparten imagen: los dos necesitan abak_core y sus dependencias
# analíticas, que son lo pesado. Una imagen por servicio duplicaría ~1.5 GB.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1

# Chromium es para kaleido: es lo que convierte una gráfica de Plotly en imagen
# para el informe en PDF. Pesa ~300 MB. Si se quita, el informe se genera igual
# —con sus tablas y su metodología— y dice en el lugar de cada figura por qué
# falta. Las tipografías DejaVu son las que le dan acentos y «·» al PDF.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential libgomp1 chromium fonts-dejavu-core \
 && rm -rf /var/lib/apt/lists/*

ENV BROWSER_PATH=/usr/bin/chromium

WORKDIR /app
COPY packages/core /app/packages/core
COPY services/worker /app/services/worker
COPY services/api /app/services/api

RUN pip install --upgrade pip \
 && pip install -e "packages/core[todo]" -e services/worker -e services/api

RUN useradd --uid 10001 --create-home abak && mkdir -p /datos && chown abak /datos
USER abak

EXPOSE 8000
CMD ["uvicorn", "abak_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
